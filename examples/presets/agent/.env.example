# Prowl secrets template (agent preset)
# ---
# Copy this file to .prowl/.env and fill in real values:
#
#     cp .prowl/.env.example .prowl/.env
#
# .prowl/.env is git-ignored (see .prowl/.gitignore) and any value defined here
# is automatically redacted from Prowl reports and JSON output. Reference these
# in hunts with {{VAR}} — e.g. vars: { EMAIL: "{{TEST_EMAIL}}" }.

# Credentials for the login-flow pattern.
TEST_EMAIL=user@example.com
TEST_PASSWORD=change-me

# Add any other secrets your hunts interpolate, e.g.:
# API_TOKEN=
# ADMIN_EMAIL=
